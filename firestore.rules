rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorized() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthorized() && getUserRole() == 'admin';
    }

    function isEquipe() {
      return isAuthorized() && getUserRole() == 'equipe';
    }

    // Cada usuário consulta o próprio perfil; somente admins listam e gerenciam usuários.
    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /campanhas/{campanhaId} {
      // Toda a equipe precisa conhecer a campanha ativa; configuração é exclusiva do admin.
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();

      // Fluxo operacional completo para admin e equipe.
      match /fichas/{fichaId} {
        allow read, create, update: if isAdmin() || isEquipe();
        allow delete: if isAdmin();
      }

      match /contatos/{contatoId} {
        allow read, create, update: if isAdmin() || isEquipe();
        allow delete: if isAdmin();
      }
    }
  }
}
